{
  "name": "kuaimai-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias && mkdir -p dist/server/database && cp database/init.sql dist/server/database/ && echo 'init.sql copied'",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/server/main.js",
    "db:init": "psql $DATABASE_URL -f database/init.sql"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/core": "^10.2.0",
    "@nestjs/platform-express": "^10.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "drizzle-orm": "^0.29.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "drizzle-kit": "^0.20.0",
    "tsc-alias": "^1.8.0",
    "typescript": "^5.3.0"
  }
}
