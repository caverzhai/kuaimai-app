FROM node:20-alpine

WORKDIR /app

# Cache bust to force rebuild
ARG CACHEBUST=20260922060000
RUN echo "Cache bust: $CACHEBUST"

# Copy backend and shared code (includes local built APK and frontend dist)
COPY server/ ./server/
COPY shared/ ./shared/

# Use local APK (already built at 2.32.0) instead of downloading from GitHub
RUN echo "Using local APK, size: $(wc -c < server/public/download/kuaimai.apk) bytes"

# Install dependencies and build
WORKDIR /app/server
RUN npm install
RUN npm run build

# Copy public to dist (ensure APK is included)
RUN rm -rf dist/public && cp -r public dist/ && echo "public copied to dist"

# Verify build
RUN ls -la dist/server/main.js && echo "Build successful"

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "server/dist/server/main.js"]
