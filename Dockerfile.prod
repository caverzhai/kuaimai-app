FROM node:20-alpine

WORKDIR /app

# Install wget for downloading APK
RUN apk add --no-cache wget

# Cache bust to force rebuild
ARG CACHEBUST=20260921163000
RUN echo "Cache bust: $CACHEBUST"

# Copy backend and shared code
COPY server/ ./server/
COPY shared/ ./shared/

# Download latest APK from GitHub (overwrites COPY)
RUN echo "=== Download latest APK ===" && \
    wget -O server/public/download/kuaimai.apk "https://raw.githubusercontent.com/caverzhai/kuaimai-app/main/server/public/download/kuaimai.apk" && \
    echo "APK downloaded, size: $(wc -c < server/public/download/kuaimai.apk) bytes"

# Install dependencies and build
WORKDIR /app/server
RUN npm install
RUN npm run build

# Copy public to dist (ensure APK is included)
RUN rm -rf dist/public && cp -r public dist/ && echo "public copied to dist"

# Verify build
RUN ls -la dist/server/main.js && echo "Build successful"

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "server/dist/server/main.js"]
